-- [[ Fake Headless Implementation ]]
local fakeHeadlessActive = false
local headTransparency = {}

local function applyFakeHeadless(character)
    if not character then return end
    local head = character:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        headTransparency[head] = head.Transparency
        head.Transparency = 1
        
        -- Remove face if present
        for _, face in ipairs(head:GetChildren()) do
            if face:IsA("Decal") and face.Name == "face" then
                face.Transparency = 1
            end
        end
    end
end

local function removeFakeHeadless(character)
    if not character then return end
    local head = character:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        head.Transparency = headTransparency[head] or 0
        
        -- Restore face if present
        for _, face in ipairs(head:GetChildren()) do
            if face:IsA("Decal") and face.Name == "face" then
                face.Transparency = 0
            end
        end
    end
end

local function updateFakeHeadless()
    local playerUtils = Config['Player Utilities']
    if playerUtils['Fake Headless'] ~= fakeHeadlessActive then
        fakeHeadlessActive = playerUtils['Fake Headless']
        
        local character = LocalPlayer.Character
        if character then
            if fakeHeadlessActive then
                applyFakeHeadless(character)
            else
                removeFakeHeadless(character)
            end
        end
    end
    
    -- Check if character changed or respawned
    if fakeHeadlessActive and LocalPlayer.Character and LocalPlayer.Character ~= character then
        character = LocalPlayer.Character
        applyFakeHeadless(character)
    end
end

