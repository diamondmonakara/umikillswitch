-- [[ Silent Aimbot Hook ]]
local mt = getrawmetatable(game) -- Get the metatable of the game
local oldIndex = mt.__index
setreadonly(mt, false)
mt.__index = newcclosure(function(self, idx)
    if not checkcaller() and self == Mouse and silentConfig['Enabled'] then
        -- Determine which character to target based on mode
        local char
        if silentConfig['Mode'] == 'Target' then
            -- In Target mode, use the locked target if available
            if silentAimToggleState and silentAimTarget then
                char = silentAimTarget
            end
        else
            -- In Auto mode, get closest player
            char = GetClosestPlayer()
        end
        
        -- Only proceed if we have a valid target and it's in FOV (for Auto mode)
        if char and (silentConfig['Mode'] == 'Target' or IsMouseInFOVBox(char, silentConfig['FOV'])) then
            local point, part = GetClosestPointFromPoints(char)
            if point and part then
                -- Apply Anti Curve adjustments if enabled
                if silentConfig['Anti Curve']['Enabled'] then
                    local antiCurve = CFrame.Angles(
                        math.rad(silentConfig['Anti Curve']['X']),
                        math.rad(silentConfig['Anti Curve']['Y']),
                        math.rad(silentConfig['Anti Curve']['Z'])
                    )
                    
                    -- Get direction from camera to target
                    local direction = (point - Camera.CFrame.Position).Unit
                    
                    -- Apply anti-curve rotation to the direction
                    direction = antiCurve:VectorToWorldSpace(direction)
                    
                    -- Update point with adjusted direction
                    point = Camera.CFrame.Position + (direction * (point - Camera.CFrame.Position).Magnitude)
                end
                
                -- Apply Clamp Y Axis if enabled
                if silentConfig['Clamp Y Axis']['Enabled'] then
                    local clampValue = silentConfig['Clamp Y Axis']['Value']
                    
                    -- Get dynamic clamp if enabled
                    if silentConfig['Clamp Y Axis']['Dynamic'] then
                        local distance = (point - Camera.CFrame.Position).Magnitude
                        clampValue = math.clamp(distance * 0.05, 5, 25) -- Dynamic scaling based on distance
                    end
                    
                    -- Apply Y-axis clamping
                    local velocity = part.Parent:FindFirstChild("HumanoidRootPart") and part.Parent.HumanoidRootPart.Velocity or Vector3.new(0,0,0)
                    if math.abs(velocity.Y) > clampValue then
                        velocity = Vector3.new(velocity.X, math.clamp(velocity.Y, -clampValue, clampValue), velocity.Z)
                        point = point + velocity * 0.05 -- Adjusted prediction with clamped Y
                    end
                end
                
                -- Apply hit chance check
                if silentConfig['HitChance'] < 100 and math.random(1, 100) > silentConfig['HitChance'] then
                    return oldIndex(self, idx)
                end
                
                if idx == "Hit" then 
                    -- Handle Client Mode if enabled
                    if silentConfig['Client Mode']['Enabled'] then
                        -- For client-side only bullet redirection
                        local legitPosition = point
                        return CFrame.new(Camera.CFrame.Position, legitPosition)
                    else
                        return CFrame.new(point)
                    end
                end
                
                if idx == "Target" then return part end
            end
        end
    end
    return oldIndex(self, idx)
end)
setreadonly(mt, true)

