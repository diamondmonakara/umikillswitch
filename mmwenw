-- [[ Script Cleanup Function ]]
local function cleanup()
    -- Remove all connections
    for _, connection in ipairs(connections) do
        if connection.Connected then
            connection:Disconnect()
        end
    end
    
    -- Restore UI elements
    silentFovBox:Destroy()
    cameraFovBox:Destroy()
    
    -- Restore hitbox sizes
    restoreHitboxSizes()
    
    -- Remove headless effect if active
    if fakeHeadlessActive then
        removeFakeHeadless(LocalPlayer.Character)
    end
    
    -- Show a simple message that the script was unloaded
    local notification = Instance.new("ScreenGui")
    notification.Name = "UmiUnloadNotification"
    notification.Parent = CoreGui
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 200, 0, 50)
    frame.Position = UDim2.new(0.5, -100, 0.9, -25)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Parent = notification
    
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.Text = "Umi Unloaded"
    text.TextColor3 = Color3.fromRGB(255, 255, 255)
    text.TextSize = 18
    text.Font = Enum.Font.GothamBold
    text.BackgroundTransparency = 1
    text.Parent = frame
    
    -- Fade out animation
    game:GetService("TweenService"):Create(frame, TweenInfo.new(1), {BackgroundTransparency = 1}):Play()
    game:GetService("TweenService"):Create(text, TweenInfo.new(1), {TextTransparency = 1}):Play()
    
    -- Remove after animation
    delay(1, function()
        notification:Destroy()
    end)
    
    script_Loaded = false
end

